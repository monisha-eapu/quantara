# ---- QuantumShield core (Node / ML-DSA) ----
PORT=4000
# Where the SQLite DB and signer private keys are stored (relative to server/)
QS_DATA_DIR=data
# Number of signed entities created by the demo seed
QS_SEED_TOTAL=2481
QUANTUM_SERVICE_URL=http://127.0.0.1:8001

# ---- IBM Quantum (optional; enables the "IBM Quantum hardware" target in the Quantum Threat Lab) ----
# API key from https://quantum.cloud.ibm.com  (never commit a real token)
IBM_QUANTUM_TOKEN=
# Instance CRN (recommended when your account has more than one instance)
IBM_QUANTUM_INSTANCE=
IBM_QUANTUM_CHANNEL=ibm_quantum_platform
# Optional fixed backend, e.g. ibm_torino. Empty = least busy backend.
IBM_QUANTUM_BACKEND=
